# ── ForensicAI Environment Configuration Example ────────────────────────────
# Copy this file to .env before starting the deployment:
# cp .env.example .env

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_USER=forensic_user
POSTGRES_PASSWORD=forensic_secret_pass
POSTGRES_DB=forensic_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://forensic_user:forensic_secret_pass@db:5432/forensic_db

# ── FastAPI Backend Configuration ──────────────────────────────────────────────
SECRET_KEY=change-this-in-production-super-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=False
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173,http://localhost

# ── Threat Intelligence API Keys (Optional) ───────────────────────────────────
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
IPINFO_TOKEN=
